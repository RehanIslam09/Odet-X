{
  "name": "@ai-project-manager/server",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Backend API for AI Project Manager",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --require tsconfig-paths/register src/index.ts",
    "worker:dev": "tsx watch --require tsconfig-paths/register src/worker.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "worker:start": "node dist/worker.js",
    "test": "cross-env NODE_ENV=test tsx src/tests/run.ts",
    "migrate:workspaces": "tsx src/scripts/migrate-workspaces.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "smoke": "cross-env NODE_ENV=test ANTHROPIC_API_KEY=smoke-key-do-not-use tsx src/smoke.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@google/genai": "^2.13.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.7.4",
    "morgan": "^1.11.0",
    "node-cron": "^3.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "mongodb-memory-server": "^11.2.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0"
  }
}
